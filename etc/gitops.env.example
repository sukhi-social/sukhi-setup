# /etc/sukhi/gitops.env — sukhi-gitops-sync の設定(git に入れない。値は箱ごと)。
# 環境名は /etc/sukhi/env に 1 行(dev / prod)。

# sukhi-infra の取得元と、読み取り専用の deploy key を使う ssh
#INFRA_URL=git@github.com:sukhi-social/sukhi-infra.git

# コミット署名: ssh(ALLOWED_SIGNERS を使う)/ gpg(GitHub のマージ署名の鍵を箱の鍵束に入れる)/ none(試験だけ)
VERIFY_COMMITS=ssh
ALLOWED_SIGNERS=/etc/sukhi/allowed_signers

# image の cosign 検証(既定で有効)。身元の正規表現は既定が sukhi-fedi の release.yml / combined-sha.yml
VERIFY_IMAGES=1

# 適用後、この秒数だけ保持して再確認
HOLD_SECS=30

# 通知(任意): 1 つの文字列を引数に呼ばれる実行ファイル
#NOTIFY_CMD=/home/sukhi/.local/bin/sukhi-notify
