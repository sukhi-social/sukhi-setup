# SPDX-License-Identifier: AGPL-3.0-or-later
# /etc/sukhi/gitops.env — sukhi-gitops-sync の設定(git に入れない。値は箱ごと)。
# 環境名は /etc/sukhi/env に 1 行(dev / prod)。

# sukhi-infra の取得元。public なので認証なしの https(既定)。private に戻すなら git@ の URL + 読み取り専用 deploy key
#INFRA_URL=https://github.com/sukhi-social/sukhi-infra.git

# コミット署名: gpg(既定)/ ssh(ALLOWED_SIGNERS を使う)/ none(試験だけ)
# gpg は専用の鍵束(GPG_HOME)に入れた鍵の署名だけを許す。普段の鍵束とは分ける
VERIFY_COMMITS=gpg
#GPG_HOME=/home/sukhi/.local/share/sukhi-gnupg
#ALLOWED_SIGNERS=/etc/sukhi/allowed_signers   # ssh のとき

# image の cosign 検証(既定で有効)。身元の正規表現は既定が sukhi-fedi の release.yml / combined-sha.yml
VERIFY_IMAGES=1

# 適用後、この秒数だけ保持して再確認
HOLD_SECS=30

# 通知(任意): 1 つの文字列を引数に呼ばれる実行ファイル
#NOTIFY_CMD=/home/sukhi/.local/bin/sukhi-notify
